    "Apple protects the system Hidden album independently of any app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحمي Apple ألبوم المخفي في النظام بشكل مستقل عن أي تطبيق."
          }
        }
      }
    },
    "Areas from existing location data": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مناطق من بيانات الموقع الموجودة"
          }
        }
      }
    },
    "Asset identifiers, tags, notes, ratings, viewing history, playback positions, collection rules and observation dates — a small local database. Never your photos or videos, and never anything sent off this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معرّفات العناصر والوسوم والملاحظات والتقييمات وسجل المشاهدة ومواضع التشغيل وقواعد المجموعات وتواريخ الرصد — قاعدة بيانات محلية صغيرة. ليست صورك أو فيديوهاتك أبدًا، ولا يغادر أي شيء هذا الجهاز."
          }
        }
      }
    },
    "Autoplay Next": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل التالي تلقائيًا"
          }
        }
      }
    },
