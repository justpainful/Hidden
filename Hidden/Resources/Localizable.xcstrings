      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المظهر"
          }
        }
      }
    },
    "Apple protects the system Hidden album independently of any app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحمي Apple ألبوم المخفي في النظام بشكل مستقل عن أي تطبيق."
          }
        }
      }
    },
    "Asset identifiers, tags, notes, ratings, viewing history, playback positions, collection rules and observation dates — a small local database. Never your photos or videos, and never anything sent off this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معرّفات العناصر والوسوم والملاحظات والتقييمات وسجل المشاهدة ومواضع التشغيل وقواعد المجموعات وتواريخ الرصد — قاعدة بيانات محلية صغيرة. ليست صورك أو فيديوهاتك أبدًا، ولا يغادر أي شيء هذا الجهاز."
          }
        }
      }
    },
    "Autoplay Next": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل التالي تلقائيًا"
          }
        }
      }
    },
    "Bar chart of items captured per year": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسم بياني للعناصر الملتقطة في كل سنة"
          }
        }
      }
    },
    "Blur Thumbnails": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمويه المصغّرات"
          }
        }
      }
    },
    "Browse, rediscover and organize the media in your Hidden album — with your library staying exactly where it is, in Apple Photos.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصفح واكتشف ونظّم الوسائط في ألبوم المخفي — بينما تبقى مكتبتك في مكانها تمامًا، داخل تطبيق الصور."
          }
        }
      }
    },
    "Buried": {
      "localizations": {
